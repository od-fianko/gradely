# ── Database ──────────────────────────────────────────────────────────────────
# Local: postgresql://USER:PASSWORD@localhost:5432/gradely
# Production: Use Neon or Supabase connection string
DATABASE_URL="postgresql://user:password@localhost:5432/gradely"

# ── Auth.js (NextAuth v5) ─────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ── Anthropic (AI grading — Short Answer module) ──────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."

# ── Code Execution (paiza.io) ─────────────────────────────────────────────────
# Piston's public API (emkc.org) went whitelist-only in Feb 2026, so code
# execution now runs through paiza.io's runner API instead. The "guest" key
# works with no signup, but is rate-limited — get a real paiza.io API key if
# that becomes a bottleneck and set it here.
PAIZA_API_KEY="guest"

# ── SendGrid (email verification OTP codes) ───────────────────────────────────
# Free tier: 100 emails/day, no credit card. Sign up at sendgrid.com, verify a
# sender identity (Settings → Sender Authentication), then create an API key
# (Settings → API Keys → Restricted Access → Mail Send). Without these set,
# OTP codes are logged to the server console instead of emailed (dev fallback).
SENDGRID_API_KEY="SG...."
SENDGRID_FROM_EMAIL="noreply@yourdomain.com"

# ── Vercel Blob (File Upload storage) ─────────────────────────────────────────
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Gradely"
